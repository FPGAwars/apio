// Apio's configuration.
{
  //
  // ===== Packages specification.
  //
  "packages": {
    // "definitions" package. Used on all platforms.
    "definitions": {
      "description": "Apio definitions"
    },
    // "oss-cad-suite" package. Used on all platforms.
    "oss-cad-suite": {
      "description": "Yosys HQ oss-cad-suite"
    },
    // "openxc7" package. Used on all platforms.
    "openxc7": {
      "description": "Openxc7 toolchain (Xilinx FPGAs)"
    },
    // "verible" package. Used on all platforms.
    "verible": {
      "description": "Chips Alliance Verible toolset"
    },
    // "drivers" package. Used on Windows only.
    "drivers": {
      "description": "Drivers tools for Windows"
    },
    // "graphviz" package. Used on Windows only.
    "graphviz": {
      "description": "Graphviz tool for Windows"
    }
  },
  //
  // ===== Platforms specifications.
  //
  "platforms": {
    "darwin-arm64": {
      "packages": [
        "definitions",
        "oss-cad-suite",
        "openxc7",
        "verible"
      ],
      "env": {
        "delete-env-vars": [
          // Delete this var, if exists. This isolate the oss-cad-suite
          // embedded python from the local python.
          "PYTHONPATH"
        ],
        "add-env-vars": {
          "VERILATOR_ROOT": "{oss-cad-suite}/share/verilator"
        },
        "add-to-path": [
          // oss-cad-suite
          "{oss-cad-suite}/bin",
          "{oss-cad-suite}/lib",
          // openxc7
          "{openxc7}/bin",
          "{openxc7}/lib",
          // Verible
          "{verible}/bin"
        ],
        "define-consts": {
          // oss-cad-suite
          "TRELLIS": "{oss-cad-suite}/share/trellis",
          "YOSYS_LIB": "{oss-cad-suite}/share/yosys",
          // openxc7
          "PRJXRAY_DB_DIR": "{openxc7}/share/nextpnr/external/prjxray-db"
        }
      }
    },
    "linux-x86-64": {
      "packages": [
        "definitions",
        "oss-cad-suite",
        "openxc7",
        "verible"
      ],
      "env": {
        "delete-env-vars": [
          // Delete this var, if exists. This isolate the oss-cad-suite
          // embedded python from the local python.
          "PYTHONPATH"
        ],
        "add-env-vars": {
          "VERILATOR_ROOT": "{oss-cad-suite}/share/verilator"
        },
        "add-to-path": [
          // oss-cad-suite
          "{oss-cad-suite}/bin",
          "{oss-cad-suite}/lib",
          // openxc7
          "{openxc7}/bin",
          "{openxc7}/lib",
          // Verible
          "{verible}/bin"
        ],
        "define-consts": {
          // oss-cad-suite
          "TRELLIS": "{oss-cad-suite}/share/trellis",
          "YOSYS_LIB": "{oss-cad-suite}/share/yosys",
          // openxc7
          "PRJXRAY_DB_DIR": "{openxc7}/share/nextpnr/external/prjxray-db"
        }
      }
    },
    "windows-amd64": {
      "packages": [
        "definitions",
        "oss-cad-suite",
        "openxc7",
        "verible",
        "drivers",
        "graphviz"
      ],
      "env": {
        "delete-env-vars": [
          // Delete this var, if exists. This isolate the oss-cad-suite
          // embedded python from the local python.
          "PYTHONPATH"
        ],
        "add-env-vars": {
          "VERILATOR_ROOT": "{oss-cad-suite}\\share/verilator"
        },
        "add-to-path": [
          // oss-cad-suite
          "{oss-cad-suite}\\bin",
          "{oss-cad-suite}\\lib",
          // openxc7
          "{openxc7}\\bin",
          "{openxc7}\\lib",
          // verible
          "{verible}\\bin",
          // drivers
          "{drivers}\\bin",
          // graphviz
          "{graphviz}\\bin"
        ],
        "define-consts": {
          // oss-cad-suite
          "TRELLIS": "{oss-cad-suite}\\share\\trellis",
          "YOSYS_LIB": "{oss-cad-suite}\\share\\yosys",
          // openxc7
          "PRJXRAY_DB_DIR": "{openxc7}\\share\\nextpnr\\external\\prjxray-db"
        }
      }
    }
  },
  //
  // ===== Remote config specification
  //
  "remote-config": {
    // How many days we keep a cached remote config before trying to fetch a
    // new one.
    "ttl-days": 1,
    // If a non mandatory remote config fetch failed, how long to wait before
    // trying again.
    "retry-minutes": 60,
    // URL of the dir with the 'apio-{major}.{minor}.x.jsonc' remote config
    // files. Supported protocols are https and file. This value is overridden
    // in tests using the env var APIO_REMOTE_CONFIG_URL.
    //
    // For using Apio with the local remote config
    // export APIO_REMOTE_CONFIG_URL="file:///Volumes/projects/apio-dev/repo/remote-config"
    //
    "url": "https://github.com/fpgawars/apio/raw/main/remote-config"
  }
}